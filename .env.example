# Loaded by `server/chat-api.mjs` from project root.
#
# Firebase (client): use VITE_* names below. In production (Docker/Railway), the same
# variables on the host are injected into the HTML at runtime — no rebuild required
# when you rotate keys (restart the service after changing vars).

# Split hosting (e.g. Cloudflare Pages UI + API elsewhere): origin only, no trailing slash.
# Example: https://api.modulon.xyz — chat requests go to {origin}/api/...
# VITE_PUBLIC_API_ORIGIN=

# Deployed website origin — used by the Electron desktop app to open
# /desktop/login in the system browser for Google sign-in.
# Example: https://modulon.vercel.app  (no trailing slash)
# VITE_PUBLIC_SITE_URL=https://modulon.xyz

# Firebase (client) — from Firebase Console → Project settings → Your apps → Web app config.
# Enables email/password + Google login and protects /chat when all required vars are set.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Local API (server/chat-api.mjs). Railway sets `PORT`; local default is 4310.
# API_PORT=4310
# Python for GPT-2 bridge: Linux / Docker usually needs python3 (default on non-Windows).
# PYTHON=python3

# Default bind is 127.0.0.1. For Docker / Railway public listen:
# API_HOST=0.0.0.0

# Chat SQLite path. Local default: data/chat.sqlite. Railway + volume: often /app/data/chat.sqlite.
# CHAT_DB_PATH=/app/data/chat.sqlite

# Optional: WAL | DELETE | TRUNCATE | PERSIST. On Railway we default to DELETE if unset.
# SQLITE_JOURNAL_MODE=DELETE
