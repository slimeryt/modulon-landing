# Loaded by `server/train-api.mjs` from project root.
# Optional: lock down /api/chat when set (same value in both places).
# ADMIN_TRAIN_SECRET=your-long-random-string
# VITE_ADMIN_TRAIN_SECRET=your-long-random-string

# Firebase (client) — from Firebase Console → Project settings → Your apps → Web app config.
# Enables email/password + Google login and protects /chat when all required vars are set.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Local API (server/train-api.mjs). Default port is 4310 (3001 is often blocked on Windows / Hyper-V).
# API_PORT=4310
# Default bind is 127.0.0.1. For public listen:
# API_HOST=0.0.0.0

# Chat SQLite path. Local default: data/chat.sqlite. Railway + volume: often /app/data/chat.sqlite.
# CHAT_DB_PATH=/app/data/chat.sqlite

# Optional: WAL | DELETE | TRUNCATE | PERSIST. On Railway we default to DELETE if unset.
# SQLITE_JOURNAL_MODE=DELETE
