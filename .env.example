# Interpreter for chatbot-ai training. Auto: project .venv, then /usr/bin/python3, then PATH.
# PYTHON=/app/.venv/bin/python
# PYTHON=/usr/bin/python3

# Loaded by `server/train-api.mjs` (npm start / dev:api / dev:all API process) from project root.
# Optional: lock down /api/train and /api/chat when set (same value in both places).
# ADMIN_TRAIN_SECRET=your-long-random-string
# VITE_ADMIN_TRAIN_SECRET=your-long-random-string

# Local only: train API port when not using PORT (Railway sets PORT automatically).
# TRAIN_API_PORT=5182

# Chat history: SQLite file path. Default locally: data/chat.sqlite
# On Railway with RAILWAY_ENVIRONMENT set, default is /app/data/chat.sqlite (volume mount).
# Override anytime:
# CHAT_DB_PATH=/app/data/chat.sqlite

# Optional: WAL | DELETE | TRUNCATE | PERSIST. On Railway we default to DELETE if unset.
# SQLITE_JOURNAL_MODE=DELETE
